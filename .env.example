# API + Worker ortak
DATABASE_URL=postgres://catdef:catdef@localhost:5432/catdef
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
# Free-tier: IP başına günlük tarama limiti
RATE_LIMIT_PER_DAY=5
# Aynı domain için cache süresi (saat)
CACHE_TTL_HOURS=24
# Tarayıcının kendini tanıttığı User-Agent
SCANNER_USER_AGENT=CatDefBot/0.1 (+https://catdef.example/about-bot)

# Web (Next.js) — tarayıcıdan erişilen API adresi
NEXT_PUBLIC_API_URL=http://localhost:3001
